// Mindinvest — hébergement Cloudflare (Workers, fichiers statiques).
// À chaque mise en ligne, la commande build assemble index.html, les icônes et le Premium
// (comme sur Netlify), puis les fichiers du dossier sont publiés.
// Le fichier _headers est appliqué automatiquement ; .assetsignore liste ce qui n'est pas publié.
{
  "name": "mindinvest",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "node build.js && node build-premium.js && node build-acces.js"
  },
  "assets": {
    "directory": "."
  }
}
